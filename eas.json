{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hrmjos.idprofitsol.com/api/mobile/",
        "EXPO_PUBLIC_STORAGE_URL": "https://hrmjos.idprofitsol.com/storage/file-attachment/file-attachment/"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.13.0"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
